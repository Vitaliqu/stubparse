# ═══ Required ════════════════════════════════════════════════════════════════

# Public URL (OG tags, sitemap, Stripe return URLs, email links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Firebase (client) — Project settings → General → Your apps → Web app ─────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server) — Project settings → Service accounts → Generate key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# One line, \n for newlines, in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Stripe (server) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (price_...) for each plan and interval
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...
# Customer portal configuration (bpc_...) that allows switching between the prices above
STRIPE_PORTAL_CONFIGURATION=bpc_...
# 1 = collect tax with Stripe Tax (turn Stripe Tax on in the Dashboard first)
# STRIPE_AUTOMATIC_TAX=1

# ── AI extraction (server) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# ═══ Recommended for production (each feature is off until its keys are set) ═

# ── Email: Resend (welcome / activation / limit emails) ──────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM="StubParse <hello@stubparse.com>"
# Required for product email: random string of 32+ characters that signs unsubscribe links
#   (generate with: openssl rand -base64 48)
# EMAIL_UNSUBSCRIBE_SECRET=
# Vercel Cron sends this as a bearer token to /api/cron/lifecycle
# CRON_SECRET=

# ── Rate limiting shared across instances: Upstash Redis ─────────────────────
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Error monitoring: Sentry ──────────────────────────────────────────────────
# SENTRY_DSN=https://...ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...
# Source-map upload during builds (optional)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Product analytics: PostHog ────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Bot protection: Firebase App Check + reCAPTCHA Enterprise ─────────────────
# Site key from Google Cloud → reCAPTCHA Enterprise (also register it in Firebase → App Check)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# 1 = reject API calls without a valid App Check token (turn on after the site key is live)
# APP_CHECK_ENFORCE=1

# ── Daily ceilings on paid plans (enforced in Firestore, across all instances) ─
# PRO_DAILY_LIMIT=300
# BUSINESS_DAILY_LIMIT=3000

# ── Search engines: verification codes from Google Search Console / Bing Webmaster Tools
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# ── Internal admin (/app/admin): verified emails, comma-separated ────────────
# ADMIN_EMAILS=you@stubparse.com

# ── End-to-end checkout journey (Stripe TEST mode only) ──────────────────────
# E2E_JOURNEY=1

# ── Plan limits ───────────────────────────────────────────────────────────────
# PRO_MONTHLY_LIMIT=1000
# BUSINESS_MONTHLY_LIMIT=10000
